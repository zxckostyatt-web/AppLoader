<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DownloadHub</AssemblyName>
    <RootNamespace>DownloadHub</RootNamespace>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    catalog.json больше не читается локально: приложение загружает его
    с GitHub (raw.githubusercontent.com) при каждом запуске. Файл в корне
    репозитория остаётся источником для этого URL и примером формата.
  -->

</Project>
